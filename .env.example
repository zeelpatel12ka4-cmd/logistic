# ChainTrace Enterprise Environment Configuration
# Copy to .env for local development. Never commit .env with real secrets.

NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chaintrace
POSTGRES_USER=chaintrace
POSTGRES_PASSWORD=chaintrace_dev_password
DATABASE_URL=postgresql://chaintrace:chaintrace_dev_password@localhost:5432/chaintrace

# IPFS Kubo
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Blockchain RPC Pool (comma-separated for automatic failover)
RPC_URLS=http://127.0.0.1:8545
CHAIN_ID=31337
CONFIRMATIONS_REQUIRED=2
INDEXER_POLL_INTERVAL_MS=1500
INDEXER_CHUNK_SIZE=2000

# Smart Contract Deployment
CONTRACT_ADDRESS=
# Optional testnet deployment (keep empty for local Hardhat node)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Backend API & Security
API_PORT=4000
JWT_SECRET=dev_only_change_me_at_least_32_characters_long
SIWE_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
# Optional gasless claim / automated load-test relayer key (leave blank to disable relayer)
RELAYER_PRIVATE_KEY=

# Frontend (Next.js public runtime vars)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CONTRACT_ADDRESS=
